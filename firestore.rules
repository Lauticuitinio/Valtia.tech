rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email helper
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'valtyaanalytics@gmail.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── INVERSORES ──
    // Solo el admin puede leer todos los documentos.
    // Cada cliente solo puede leer y actualizar su propio documento.
    match /inversores/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email == email);
      allow write: if isAdmin();

      // ── MI CARTERA ──
      // Las posiciones que carga el propio cliente para su seguimiento.
      // Solo él (y el admin) las ve y las administra.
      function esDuenio() {
        return isAdmin() || (isAuthenticated() && request.auth.token.email == email);
      }
      match /cartera/{posId} {
        allow read, delete: if esDuenio();
        allow create, update: if esDuenio()
                              && request.resource.data.ticker is string
                              && request.resource.data.ticker.size() > 0
                              && request.resource.data.ticker.size() <= 12
                              && request.resource.data.cantidad is number
                              && request.resource.data.cantidad > 0;
      }
    }

    // ── PRECIOS Y FUNDAMENTALS DE LOS TICKERS DE CLIENTES ──
    // El sync diario baja precio y ratios de cada ticker que algún cliente
    // tenga en su cartera, y les calcula la lectura Valtia contra el radar.
    match /precios/{ticker} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── SOLICITUDES ──
    // Clientes autenticados pueden crear solicitudes propias y leer las suyas.
    // Solo el admin puede leer todas, actualizar estado (aprobar/rechazar).
    match /solicitudes/{solicitudId} {
      allow create: if isAuthenticated()
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.tipo in ['deposito', 'rescate']
                    && request.resource.data.monto is number
                    && request.resource.data.monto > 0
                    && request.resource.data.estado == 'pendiente';

      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.email == request.auth.token.email);

      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
                    && request.resource.data.estado in ['aprobado', 'rechazado'];

      allow delete: if isAdmin();
    }

    // ── FONDO SYNC ──
    // Snapshot diario del fondo (IOL + Binance) escrito por fondo_sync.py
    // via Admin SDK (la escritura no pasa por estas reglas).
    match /fondoSync/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── METADATA DEL FONDO (Google Sheet: clientes, fee, historial) ──
    // Escrito por fondo_sync.py via Admin SDK. Solo el admin lo lee.
    match /fondoMeta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── EVENTOS DEL FONDO (aportes/retiros anotados desde el panel admin) ──
    // El admin los crea desde la web; fondo_sync.py los consolida en el
    // Google Sheet y los marca como aplicados (via Admin SDK).
    match /fondoEventos/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ── CARTERAS MODELO (producto: carteras vivas) ──
    // Escritas por el admin / fondo_sync (Admin SDK). Las de visibilidad
    // "publico" las ve cualquiera; el resto requiere login (PRO a futuro).
    match /carterasModelo/{id} {
      allow read: if resource.data.visibilidad == 'publico' || isAuthenticated();
      allow write: if isAdmin();

      // El contenido de la cartera (posiciones, rotaciones y serie de valores)
      // hereda la visibilidad de la cartera padre. Antes estaba en "true" y
      // las posiciones de las carteras de suscriptores se podían leer sin
      // login pegándole directo a la API — el candado era solo visual.
      function carteraPublica() {
        return get(/databases/$(database)/documents/carterasModelo/$(id))
                 .data.visibilidad == 'publico';
      }
      match /posiciones/{p} { allow read: if carteraPublica() || isAuthenticated(); allow write: if isAdmin(); }
      match /historial/{h}  { allow read: if carteraPublica() || isAuthenticated(); allow write: if isAdmin(); }
      match /valores/{v}    { allow read: if carteraPublica() || isAuthenticated(); allow write: if isAdmin(); }
    }

    // ── SEÑALES Y RÉGIMEN DE MERCADO (sistema de rotación) ──
    // Calculado a diario por fondo_sync.py. Privado del gestor por ahora
    // (a futuro: producto PRO con visibilidad por plan).
    match /mercado/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── RADAR DE VALUACIÓN (herramienta pública + panel admin) ──
    // Fundamentals objetivos + lectura propia Valtia. Solo dato de mercado,
    // sin posiciones ni etiquetas de terceros: lectura pública. Escrito por
    // seed_radar.py / fondo_sync.py (Admin SDK).
    match /radar/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── NOTICIAS PÚBLICAS (sección Noticias del sitio) ──
    // Solo las publicadas son visibles (query con filtro estado). El admin
    // gestiona borradores vía Admin SDK / consola. Cualquiera puede sumar
    // UNA vista por update (ranking "las más leídas"): el único cambio
    // permitido es vistas = vistas + 1.
    match /noticias/{docId} {
      allow read: if resource.data.estado == 'publicado' || isAdmin();
      allow update: if isAdmin()
        || (resource.data.estado == 'publicado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistas'])
            && request.resource.data.vistas is int
            && request.resource.data.vistas == resource.data.get('vistas', 0) + 1);
      allow create, delete: if isAdmin();
    }

    // ── NEWSLETTER (suscripciones desde Noticias) ──
    // Cualquiera puede suscribirse (solo crear, con forma de email); la
    // lista solo la ve el admin. La baja es por link con el id del doc
    // (id aleatorio no adivinable que solo viaja en el mail del suscripto),
    // por eso delete abierto: sin lectura pública no se pueden enumerar.
    match /newsletter/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'fecha'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.email.size() < 120;
      allow delete: if true;
      allow read, update: if isAdmin();
    }

    // ── INFORMES DE RESEARCH ──
    // Los "publico" los ve cualquiera; los "clientes" requieren login.
    // Escritos por el admin / seed via Admin SDK.
    match /informes/{docId} {
      allow read: if resource.data.visibilidad == 'publico' || isAuthenticated();
      allow write: if isAdmin();
    }

    // ── BALANCE CONSOLIDADO DEL FONDO (fondo_web.json) ──
    // KPIs, cierres mensuales, clientes por nombre y cuenta del gestor.
    // Datos de clientes reales → solo el admin.
    match /fondoWeb/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── ANÁLISIS DE LA CARTERA DEL FONDO (mapa por posición) ──
    // Contiene posiciones y tamaños reales del fondo. Solo el admin.
    match /fondoAnalisis/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── LEDGER CONTABLE DEL FONDO (fuente de verdad, reemplaza al sheet) ──
    // Aportes/devoluciones por cliente, cierres y cuenta del gestor.
    // Escrito solo por fondo_sync.py via Admin SDK.
    match /fondoLedger/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── HISTORIAL DIARIO DE VALUACIÓN (curva de evolución del fondo) ──
    // Un doc por día {fecha, total_ars, iol_ars, binance_usd, fx}.
    // Totales privados del fondo → solo el admin.
    match /fondoHistorial/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── VALUACIÓN INTRADÍA (curva "1D": un doc por día, puntos cada 15') ──
    match /fondoIntradia/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── NOTICIAS DEL FONDO ──
    // Briefings diarios generados por la tarea de Cowork, copiados por
    // fondo_sync.py via Admin SDK. Solo el admin las ve.
    match /noticiasFondo/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
